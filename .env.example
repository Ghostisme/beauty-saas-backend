# Generate different random secrets of at least 32 bytes. Never commit real values.
# Used by Docker Compose; for mvn spring-boot:run, export the same environment variables in the shell.
JWT_SECRET=
PLATFORM_PROVISIONING_KEY=
# Only for a completely new installation without a platform admin. Does not reset existing accounts.
PLATFORM_ADMIN_INITIAL_PASSWORD=
# Add the exact LAN frontend origin for phone/PAD access (for example http://192.168.1.5:5173).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
