# ═══════════════════════════════════════════════════════════════════════
#  后端环境变量模板  →  /opt/beauty-saas/server.env
#
#  这份文件含全部密钥，只有 beauty-api 流水线读它。
#  前端那条流水线读的是 web.env，整条前端链路接触不到任何密钥。
#
#  权限：chmod 600，owner root。Jenkins 用 ACL 单独放行读权限
#  （见 deploy/README.md 的「给 Jenkins 授权」一节）。
#
#  ⚠️ 格式限制：Docker 的 env_file 解析器只认三种行 —— # 注释、空行、
#     KEY=VALUE。值不要加引号（引号会被当成值的一部分），不要写行尾注释。
#     Jenkinsfile 的环境自检阶段会校验格式并指出出错行号。
#
#  生成随机值：openssl rand -hex 32
# ═══════════════════════════════════════════════════════════════════════

# ── 数据库 ──────────────────────────────────────────────────────────
# 本栈自带的 MySQL 实例专用，和 portfolio-mysql 的密码无关，不要复用
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root
# 应用连库用的账号。容器首次启动时由 MySQL 镜像自动建号并授权 beauty_saas 库
MYSQL_PASSWORD=CHANGE_ME_mysql_beauty

# ── 应用密钥 ────────────────────────────────────────────────────────
# JWT 签名密钥，至少 32 字节。改这个值会让所有已签发的 token 立即失效
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_bytes

# 自助开通企业通道的密钥。SecurityConfig 里 POST /platform/tenants 是
# permitAll（免登录），全靠这个 key 挡住，必须是强随机值
PLATFORM_PROVISIONING_KEY=CHANGE_ME_provisioning_key

# 仅在全新空库、尚无平台账号时用来初始化平台 admin；不会重置已存在的账号。
# 首次登录成功后建议清空此行，再跑一次 beauty-api 流水线勾 REDEPLOY。
PLATFORM_ADMIN_INITIAL_PASSWORD=CHANGE_ME_admin_first_login

# ── CORS ────────────────────────────────────────────────────────────
# 同源部署下浏览器不发跨域请求，这个值实际用不上；但 CorsConfig 的 @Value
# 没有默认值，留空会导致应用启动失败，所以必须填。
CORS_ALLOWED_ORIGINS=https://beauty.darkrich.com
